{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "dir": "web/src"
  },
  "mutate": [
    "web/src/**/*.{ts,tsx}",
    "!web/src/**/*.test.{ts,tsx}",
    "!web/src/**/*.snapshot.test.tsx",
    "!web/src/**/*.constants.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "break": 100
  }
}
