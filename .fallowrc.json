{
  "$schema": "./node_modules/fallow/schema.json",
  "health": {
    "maxCyclomatic": 3,
    "maxCognitive": 3,
    "maxCrap": 5,
    "thresholdOverrides": [
      {
        "files": ["meta/**"],
        "maxCyclomatic": 4,
        "reason": "Repo gates are straight-line validators; three guard clauses is cyclomatic 4."
      }
    ]
  },
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error"
  }
}
