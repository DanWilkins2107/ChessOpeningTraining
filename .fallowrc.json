{
  "$schema": "./node_modules/fallow/schema.json",
  "production": { "deadCode": true },
  "entry": ["web/src/main.tsx", "web/vite.config.ts", "web/tests/setup.ts"],
  "ignoreFindings": ["meta/**", "web/meta/**", "web/src/tests-shared/**"],
  "health": {
    "maxCyclomatic": 6,
    "maxCognitive": 8
  },
  "rules": {
    "stale-suppressions": "error",
    "require-suppression-reason": "error"
  }
}
