// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MoveTreeList > matches snapshot with move trees 1`] = `
<div>
  <form
    class="create-move-tree-form"
  >
    <div
      class="create-move-tree-fields"
    >
      <div
        class="text-input"
      >
        <label
          for="_r_0_"
        >
          Move tree name
        </label>
        <div
          class="text-input-control"
        >
          <input
            autocomplete="off"
            class="text-input-field"
            id="_r_0_"
            maxlength="100"
            name="name"
            required=""
            type="text"
          />
        </div>
      </div>
      <fieldset
        class="side-picker"
      >
        <legend
          class="side-picker-legend"
        >
          Side
        </legend>
        <div
          class="side-picker-options"
        >
          <label
            class="side-picker-option"
          >
            <input
              checked=""
              class="side-picker-input"
              name="side"
              type="radio"
              value="white"
            />
            <span
              class="side-picker-name"
            >
              white
            </span>
          </label>
          <label
            class="side-picker-option"
          >
            <input
              class="side-picker-input"
              name="side"
              type="radio"
              value="black"
            />
            <span
              class="side-picker-name"
            >
              black
            </span>
          </label>
        </div>
      </fieldset>
      <button
        class="button"
        disabled=""
        type="submit"
      >
        Create move tree
      </button>
    </div>
  </form>
  <ul
    aria-label="Move trees"
    class="move-tree-list"
  >
    <li
      class="move-tree-list-item"
    >
      Main line
    </li>
  </ul>
</div>
`;

