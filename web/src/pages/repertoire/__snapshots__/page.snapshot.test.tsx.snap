// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Repertoire > matches snapshot 1`] = `
<div>
  <section
    class="repertoire"
  >
    <h1>
      Repertoire
    </h1>
    <section
      aria-labelledby="train-card-heading"
      class="train-card"
    >
      <h2
        class="train-card-heading"
        id="train-card-heading"
      >
        Train
      </h2>
      <p
        class="train-card-stat"
      >
        Not trained yet
      </p>
      <p
        class="train-card-stat"
      >
        0 moves trained today
      </p>
      <a
        class="train-card-action"
        data-discover="true"
        href="/train"
      >
        Start training
      </a>
    </section>
    <form
      class="create-folder-form"
    >
      <div
        class="create-folder-fields"
      >
        <div
          class="text-input"
        >
          <label
            for="_r_0_"
          >
            Folder name
          </label>
          <div
            class="text-input-control"
          >
            <input
              autocomplete="off"
              class="text-input-field"
              id="_r_0_"
              maxlength="100"
              name="name"
              required=""
              type="text"
            />
          </div>
        </div>
        <button
          class="button"
          disabled=""
          type="submit"
        >
          Create folder
        </button>
      </div>
    </form>
    <p
      class="repertoire-empty"
    >
      No folders yet
    </p>
  </section>
</div>
`;
